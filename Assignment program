#include <stdio.h>

int main()
{
    int mark;

    printf("Enter mark out of 100: ");
    scanf("%d", &mark);

    if (mark < 0 || mark > 100)
        printf("Invalid mark");
    else if (mark >= 90)
        printf("Grade O");
    else if (mark >= 80)
        printf("Grade A+");
    else if (mark >= 70)
        printf("Grade A");
    else if (mark >= 60)
        printf("Grade B");
    else if (mark >= 50)
        printf("Grade C");
    else
        printf("Fail");

}










#include <stdio.h>

int main()
{
    float weight, height, bmi;

    printf("Enter weight in kg: ");
    scanf("%f", &weight);

    printf("Enter height in meters: ");
    scanf("%f", &height);

    if (weight <= 0 || height <= 0)
    {
        printf("Invalid input");
    }
    else
    {
        bmi = weight / (height * height);

        printf("BMI = %.2f\n", bmi);

        if (bmi < 18.5)
            printf("Underweight");
        else if (bmi < 25)
            printf("Normal");
        else if (bmi < 30)
            printf("Overweight");
        else
            printf("Obese");
    }

}












