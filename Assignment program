#include <stdio.h>

int main()
{
    float amount, discount = 0, delivery = 0, total;
    int membership;

    printf("Enter order amount: ");
    scanf("%f", &amount);

    printf("Enter membership (1-Premium, 0-Regular): ");
    scanf("%d", &membership);

    if (amount < 0 || (membership != 0 && membership != 1))
    {
        printf("Invalid input");
    }
    else
    {
        if (amount >= 500)
        {
            delivery = 0;

            if (membership == 1)
                discount = amount * 0.10;
        }
        else
        {
            delivery = 50;
        }

        total = amount - discount + delivery;

        printf("Discount = Rs. %.2f\n", discount);
        printf("Delivery charge = Rs. %.2f\n", delivery);
        printf("Final amount = Rs. %.2f\n", total);
    }

}












#include <stdio.h>

